# Copy to .env.local for local development. Never commit real values.
# Server-side only: these are read by api/nim/* and vite.config.js, never bundled into the browser.

# NVIDIA NIM (build.nvidia.com). Used for frame reading, frame findings, text safety, and explanations.
NVIDIA_API_KEY=

# SerpAPI (serpapi.com, free plan). Used for live web search when checking claims, if no fact check matches.
SERPAPI_KEY=

# Google Fact Check Tools API (free within standard quota). Checked first for claims. Optional.
FACT_CHECK_API_KEY=

# Optional: local Python media backend (server/app.py) for Whisper transcription and Chromaprint.
RELAYPROOF_API_TOKEN=

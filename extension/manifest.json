{
  "manifest_version": 3,
  "name": "RelayProof Media Check",
  "version": "0.2.0",
  "description": "Check a local RelayProof sidecar against a selected media file or a user-captured current-tab audio clip.",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Check media with RelayProof",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}

{
  "name": "relayproof-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "watch:competitors": "python3 scripts/competitor_watch.py",
    "test:watch": "python3 scripts/test_competitor_watch.py",
    "test:credentials": "node --test test/credential.test.mjs",
    "test:sebi": "node --test test/sebi-preflight.test.mjs",
    "test:sbr": "python3 -m unittest server.test_sbr_contract",
    "test:server": "python3 -m unittest server.test_local_guard server.test_sbr_contract",
    "test:extension": "node --test test/extension-capture.test.mjs test/extension-credential-sync.test.mjs",
    "test:analysis": "node --test test/findings.test.mjs test/captions.test.mjs test/nim-parse.test.mjs test/sampling.test.mjs test/request.test.mjs test/provenance.test.mjs test/reverse-search.test.mjs test/media-check.test.mjs",
    "test:nim": "node --test test/nim-api.test.mjs test/analyze-frames-api.test.mjs test/evidence.test.mjs",
    "verify:speech": "node scripts/verify-speech.mjs",
    "test:e2e": "python3 test/e2e/analyze-browser.py",
    "test:clip": "scripts/make-test-clip.sh",
    "scan:bundle": "node scripts/bundle-secrets.mjs dist"
  },
  "dependencies": {
    "@contentauth/c2pa-web": "^0.15.3",
    "@huggingface/transformers": "^4.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.4"
  }
}
